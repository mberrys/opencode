{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "noUnusedLocals": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noUncheckedIndexedAccess": false,
    // The exported verifier is plain JavaScript; tests import it, but it is not type-checked.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "test"]
}
