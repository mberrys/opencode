{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/research-library",
  "version": "2.2.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./extract": "./src/extract.ts",
    "./tree": "./src/tree.ts",
    "./source": "./src/source.ts",
    "./find": "./src/find.ts",
    "./workspace": "./src/workspace.ts",
    "./metadata": "./src/metadata.ts"
  },
  "scripts": {
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/research-record": "workspace:*",
    "@opencode/research-store": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}
