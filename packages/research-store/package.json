{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/research-store",
  "version": "2.2.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./store": "./src/store.ts",
    "./verify": "./src/verify.ts",
    "./replay": "./src/replay.ts",
    "./export": "./src/export.ts"
  },
  "scripts": {
