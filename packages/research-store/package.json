{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/research-store",
  "version": "2.3.0",
  "private": true,
  "description": "The research record's store: content-addressed blobs and a hash-chained commit log in .research/",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/research-record": "workspace:*"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
